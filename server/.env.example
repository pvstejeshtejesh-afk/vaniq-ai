# Vaniq.Ai — environment configuration
# Copy to `server/.env` and fill in values. NEVER commit real secrets.

# ---- Core ----
NODE_ENV=development
PORT=4000

# Data layer: "memory" (default, zero-dependency, resets on restart) or "mongo"
STORAGE=memory
# Required only when STORAGE=mongo
# MONGODB_URI=mongodb://localhost:27017/vaniq

# Auth
JWT_SECRET=change-me-to-a-long-random-string-32-chars
JWT_EXPIRES_MIN=10080
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# ---- Providers (all mocked when absent — see docs/PROVIDERS.md) ----
LLM_PROVIDER=mock
LLM_API_KEY=
TELEPHONY_PROVIDER=mock
TELEPHONY_API_KEY=
STT_PROVIDER=mock
TTS_PROVIDER=mock

# Safety: keep false until telephony credentials + consent/policy tests are verified.
# The mock telephony adapter never dials, so mock calls always work regardless.
OUTBOUND_CALLING_ENABLED=false

# ---- Payments (Razorpay) ----
# Leave blank to use the clearly-marked MOCK adapter (no real money).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Used to verify incoming webhook signatures. Required for live webhooks.
RAZORPAY_WEBHOOK_SECRET=

# ---- Pricing defaults (integer paise) ----
DEFAULT_STANDARD_RATE_PAISE=350   # ₹3.50 / min
DEFAULT_PREMIUM_RATE_PAISE=550    # ₹5.50 / min
DEFAULT_MIN_BALANCE_PAISE=50000   # ₹500 low-balance threshold
